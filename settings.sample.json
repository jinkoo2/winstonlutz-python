// Copy to settings.json next to WinstonLutz.gui.exe and WinstonLutz.service.exe. Saving Settings in the GUI drops comments.
{
  "Institution": "Your Institution",
  "RunMode": "Clinic",
  "Identity": {
    "user_id_method": "None",
